{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "openapi:generate": {
      "outputs": ["src/generated/**"]
    },
    "openapi:generate:check": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
