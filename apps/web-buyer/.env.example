# ─── web-buyer 환경변수 ────────────────────────────────────────────────────────
# 배포 환경별 값과 Cloudflare에 넣는 형태는 docs/deploy-env.md의 표가 정본이다.
#
# | 변수                  | 로컬                   | dev                             | prod                        |
# |-----------------------|------------------------|---------------------------------|-----------------------------|
# | VITE_API_BASE_URL     | http://localhost:8080  | https://api-dev.aechak.co.kr    | https://api.aechak.co.kr    |
# | VITE_MEDIA_BASE_URL   | (미설정 가능)          | https://media-dev.aechak.co.kr  | https://media.aechak.co.kr  |

# 인증·카탈로그·주문·presigned 발급을 담당하는 api 모듈 origin.
# origin만 적는다 — 경로 접두 /api/v1은 코드(packages/api client.ts)가 붙인다.
# 운영 빌드에서 이 값이 비거나 localhost를 가리키면 앱이 부팅을 멈추고 사유를 화면에 띄운다.
VITE_API_BASE_URL=http://localhost:8080

# 이미지 저장 키를 공개 URL로 조립하는 CDN base. 미설정이거나 서버가 키를 null로 주면
# URL을 지어내지 않고 placeholder 썸네일을 보여준다(검증 대상 아님).
VITE_MEDIA_BASE_URL=https://media-dev.aechak.co.kr
