    "@aechak/design-system": "workspace:*",
    "@aechak/domain": "workspace:*",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/router-vite-plugin": "^1.167.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@aechak/eslint-config": "workspace:*",
    "@aechak/tailwind-config": "workspace:*",
    "@aechak/tsconfig": "workspace:*",
    "@playwright/test": "^1.52.0",
    "@tanstack/react-query-devtools": "^5.80.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-plugin-boundaries": "^5.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
