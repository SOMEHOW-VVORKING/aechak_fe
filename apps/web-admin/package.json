{
  "name": "@aechak/web-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-routes": "node scripts/generate-routes.cjs",
    "typecheck": "node scripts/generate-routes.cjs && tsc -b",
    "lint": "eslint .",
